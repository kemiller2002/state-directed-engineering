# Operating-system files
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node
node_modules/

# SDE distribution build output (generated by distribution/src/build.mjs;
# never an independent source of truth — see distribution/DISTRIBUTION-MAP.json)
distribution/dist/

# Generated transient work
work/staging/*
work/review/*
logs/*

# Preserve directory markers and documentation
!work/staging/.gitkeep
!work/review/.gitkeep
!logs/.gitkeep

# Secrets
.env
.env.*
!.env.example
*.pem
*.key
